# ---------------------------------------------------------------------------
# The One-Person AI Creator Studio - environment template
# Copy to .env.local for development and fill in only what you have.
# NEVER commit the populated .env file.
# ---------------------------------------------------------------------------

# --- Required ---
# SQLite for local development. Production targets PostgreSQL - see docs/deployment.md
DATABASE_URL="file:./creator-studio.db"

# Authentication (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="change-me-generate-a-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Bootstrap account (used by the seed script only) ---
SEED_CREATOR_EMAIL="creator@example.com"
SEED_CREATOR_PASSWORD="change-me-min-8-chars"
SEED_WORKSPACE_NAME="My Creator Studio"

# --- External scheduler secret (/api/cron/* endpoints) ---
CRON_SECRET="change-me-random-string"

# --- AI providers (all optional; adapters fall back to CLEARLY-LABELED dev mocks) ---
# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Transcription (OpenAI Whisper-compatible endpoint or ElevenLabs S2T)
TRANSCRIPTION_PROVIDER=
# Speech generation
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Image generation
IMAGE_PROVIDER=
OPENAI_IMAGE_API_KEY=
# Video generation
VIDEO_PROVIDER=
HIGGSFIELD_API_KEY=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Communications / notifications ---
SLACK_WEBHOOK_URL=
# Email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# --- Social distribution (OAuth apps) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Scheduling / booking ---
CAL_API_KEY=

# --- Mobile app: server URL the Android build points at ---
CREATOR_STUDIO_SERVER_URL=
